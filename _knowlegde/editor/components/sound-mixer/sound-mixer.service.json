  "vector_memory": {
    "semantic_summary": "SoundMixerPlaybackService is the central controller for audio playback within the editor, managing the entire lifecycle from single-note previews to complex sequence rendering. It abstracts low-level audio engine interactions, synchronizing musical data (SynthNote[]) with the SequencerClock. Key responsibilities include state management via Angular signals, handling playback control (play, pause, stop, seek), and performing offline WAV file exports using OfflineAudioContext."
  },
